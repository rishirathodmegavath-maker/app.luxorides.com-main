# Copy this file to .env.local for local development, or set these as real
# environment variables in your deployment platform (Vercel project settings,
# Docker build args, etc.) for staging/production. Never commit .env.local,
# .env.production, or any file containing real values -- only this example
# file with placeholders is tracked in git.

# Core Backend base URL (Fleetovo core-service), no trailing slash.
#
# Read by services/config.ts. Used both server-side (the /api and /file-api
# proxy routes) and client-side (the WebSocket hooks and the public
# trip-share page connect to the backend directly from the browser), so it
# must be a NEXT_PUBLIC_ variable and must be publicly reachable -- it is not
# a secret, just this deployment's backend hostname.
#
# If unset:
#   - development (`next dev`): defaults to http://localhost:8443
#   - production (`next build` / `next start`): the app refuses to start
#     rather than silently falling back to localhost.
#
# Because NEXT_PUBLIC_ variables are baked into the JavaScript bundle at
# BUILD time, this must be set when the production build is created (e.g.
# `docker build --build-arg NEXT_PUBLIC_API_BASE_URL=...`), not only at
# container/server runtime.
NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com
